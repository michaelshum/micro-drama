# Local API port is set by npm scripts. Copy this file to .env.local when using npm run dev:local:env.

# Preferred: local Stream signing for thumbnails and playback tickets.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_PRIVATE_KEY=

# Fallback: API-based Stream token creation when local signing is not configured.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# Optional overrides.
# PLAYBACK_TOKEN_TTL_SECONDS=1800
# IMAGE_TOKEN_TTL_SECONDS=86400
